# Leave DATABASE_URL unset to use a local SQLite file (easiest).
# For Postgres: DATABASE_URL=postgresql://user:password@localhost:5432/ubchub
DATABASE_URL=
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Auth0 (see AUTH0_SETUP.md). Domain looks like dev-abc123.us.auth0.com
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://ubchub-api

# Allowed frontend origins (comma-separated, no trailing slash). Default: localhost 5173/5174 and the live site.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://skillshare.app.space
